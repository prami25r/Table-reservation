{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@api/*": ["src/api/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src", "packages/**/*", "apps/**/*"],
  "exclude": ["node_modules", "Pods"]
}
